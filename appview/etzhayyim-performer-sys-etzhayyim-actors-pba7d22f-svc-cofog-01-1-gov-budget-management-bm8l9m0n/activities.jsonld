      "type": "dodaf:OperationalActivity",
      "name": "Japan Government Budget Management Workflow",
      "description": "Automated workflow for budget distribution and execution tracking (COFOG 01.1).",
      "cofog": "01.1",
      "hasSubActivity": [
        {
          "id": "https://kyber-services.etzhayyim.com/activities/budget-initial-distribution",
