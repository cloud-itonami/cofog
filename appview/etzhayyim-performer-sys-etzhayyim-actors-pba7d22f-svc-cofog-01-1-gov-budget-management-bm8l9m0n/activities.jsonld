          "name": "Initial Budget Distribution",
          "description": "Allocating initial funds to L1-L3 services based on cabinet decision."
        },
        {
          "id": "https://kyber-services.etzhayyim.com/activities/budget-expense-execution",
          "type": "dodaf:OperationalActivity",
          "name": "Budget Expense Execution",
          "description": "Recording and verifying expenses from L3 divisions."
        },
        {
          "id": "https://kyber-services.etzhayyim.com/activities/budget-variance-monitoring",
          "type": "dodaf:OperationalActivity",
          "name": "Budget Variance Monitoring",
          "description": "Monitoring deviation from allocated budget and triggering alerts."
        }
      ]
