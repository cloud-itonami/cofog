(ns cofog.civil-defense
  (:export [govern approve checkpoint-command delivery-checkpoint-command main]))

;; Civilian-only COFOG 0220 application semantics. The host owns signature
;; verification, clock observation, CAS storage, and transport. This module
;; accepts their correlated results and returns a deterministic decision or a
;; single-key checkpoint/outbox command. It has no ambient authority.

(defrecord CivilEvent
  [event-id :string
   kind :i64
   authority-id :string
   issued-at :i64
   effective-at :i64
   expires-at :i64
   country-code :string
   area-code :string
   source-origin :string
   source-url :string
   hazard-kind :i64
   severity :i64
   instructions :string
   reference-event-id :string
   status :i64
   capacity-band :i64
   resource-kind :i64
   summary :string])

(defrecord GovernEvidence
  [now :i64
   authority-known :bool
   origin-allowed :bool
   signature-valid :bool
   existing-state :i64
   reference-found :bool
   reference-authority-matches :bool
   reference-area-matches :bool
   reference-issued-at :i64])

(defrecord GovernRequest
  [event [:ref :cofog.civil-defense/CivilEvent]
   evidence [:ref :cofog.civil-defense/GovernEvidence]])

(defrecord Decision
  [outcome :i64
   reasons :i64
   operation :i64
   event-id :string
   event-hash :string
   event :document
   proposal :document])

(defrecord ApprovalRequest
  [decision-outcome :i64
   event-id :string
   event-hash :string
   operation :i64
   proposal-expires-at :i64
   approval-id :string
   approver-id :string
   approval-event-id :string
   approval-event-hash :string
   approval-operation :i64
   approved-at :i64
   approval-expires-at :i64
   now :i64
   approver-known :bool
   signature-valid :bool
   already-used :bool])

(defrecord ApprovalDecision
  [outcome :i64
   reasons :i64
   approval-id :string
   outbox-id :string
   payload :document
   payload-hash :string])

(defrecord DeliveryRequest
  [outbox-id :string
   approval-id :string
   event-id :string
   event-hash :string
   operation :i64
   channel :string
   external-id :string
   delivered-at :i64
   sequence :i64
   previous-hash :string])

;; Outcome codes: 1 commit, 2 noop, 3 hold, 4 ready, 5 delivered.
;; Existing-state codes: 0 absent, 1 same event hash, 2 conflicting event id.
;; Event kind codes: 1 alert-issued, 2 alert-updated, 3 alert-cancelled,
;; 4 shelter-status, 5 facility-outage, 6 non-clinical-resource-request.

(defn nonempty? [value :string] :bool
  (> (string-length value) 0))

(defn between? [value :i64 low :i64 high :i64] :bool
  (and (>= value low) (<= value high)))

(defn https-url? [value :string] :bool
  (if (>= (string-length value) 8)
    (string=? (string-substring value 0 8) "https://")
    false))

(defn contains-prohibited-text? [value :string] :bool
  (let [text (string-fold-case value)]
    (or (string-contains? text "trajectory")
        (string-contains? text "intercept")
        (string-contains? text "target coordinate")
        (string-contains? text "weapon assignment")
        (string-contains? text "launch site")
        (string-contains? text "sensor track")
        (string-contains? text "military unit")
        (string-contains? text "friendly force")
        (string-contains? text "person id")
        (string-contains? text "device id")
        (string-contains? text "user location"))))

(defn alert-kind? [kind :i64] :bool
  (or (= kind 1) (= kind 2)))

(defn reference-kind? [kind :i64] :bool
  (or (= kind 2) (= kind 3)))

(defn kind-fields-valid? [event [:ref :cofog.civil-defense/CivilEvent]] :bool
  (let [kind (:kind event)]
    (if (alert-kind? kind)
      (and (between? (:hazard-kind event) 1 5)
           (between? (:severity event) 1 3)
           (nonempty? (:instructions event))
           (if (= kind 2) (nonempty? (:reference-event-id event)) true))
      (if (= kind 3)
        (nonempty? (:reference-event-id event))
        (if (= kind 4)
          (and (between? (:status event) 1 3)
               (between? (:capacity-band event) 1 4))
          (if (= kind 5)
            (and (between? (:status event) 1 3)
                 (between? (:resource-kind event) 1 5))
            (if (= kind 6)
              (between? (:resource-kind event) 1 5)
              false)))))))

(defn event-shape-valid? [event [:ref :cofog.civil-defense/CivilEvent]] :bool
  (and (nonempty? (:event-id event))
       (nonempty? (:authority-id event))
       (between? (:kind event) 1 6)
       (<= (:issued-at event) (:effective-at event))
       (< (:effective-at event) (:expires-at event))
       (= (string-length (:country-code event)) 2)
       (nonempty? (:area-code event))
       (https-url? (:source-url event))
       (https-url? (:source-origin event))
       (kind-fields-valid? event)))

(defn event-document [event [:ref :cofog.civil-defense/CivilEvent]] :document
  (document-map
   :schema-version (document-string "cofog-0220/v1")
   :event-id (document-string (:event-id event))
   :kind (document-i64 (:kind event))
   :authority-id (document-string (:authority-id event))
   :issued-at (document-i64 (:issued-at event))
   :effective-at (document-i64 (:effective-at event))
   :expires-at (document-i64 (:expires-at event))
   :country-code (document-string (:country-code event))
   :area-code (document-string (:area-code event))
   :source-origin (document-string (:source-origin event))
   :source-url (document-string (:source-url event))
   :hazard-kind (document-i64 (:hazard-kind event))
   :severity (document-i64 (:severity event))
   :instructions (document-string (:instructions event))
   :reference-event-id (document-string (:reference-event-id event))
   :status (document-i64 (:status event))
   :capacity-band (document-i64 (:capacity-band event))
   :resource-kind (document-i64 (:resource-kind event))
   :summary (document-string (:summary event))))

(defn operation-for [kind :i64] :i64
  (if (or (= kind 1) (= kind 2))
    1
    (if (= kind 3)
      2
      (if (= kind 4)
        3
        (if (= kind 5) 4 5)))))

(defn proposal-document [event [:ref :cofog.civil-defense/CivilEvent] operation :i64] :document
  (document-map
   :effect (document-keyword :propose)
   :operation (document-i64 operation)
   :event-id (document-string (:event-id event))
   :country-code (document-string (:country-code event))
   :area-code (document-string (:area-code event))
   :expires-at (document-i64 (:expires-at event))
   :requires-human-approval (document-bool true)))

(defn reference-reasons
  [event [:ref :cofog.civil-defense/CivilEvent]
   evidence [:ref :cofog.civil-defense/GovernEvidence]] :i64
  (if (reference-kind? (:kind event))
    (if (not (:reference-found evidence))
      512
      (let [authority-reason (if (:reference-authority-matches evidence) 0 1024)
            area-reason (if (:reference-area-matches evidence) 0 2048)
            time-reason (if (>= (:issued-at event) (:reference-issued-at evidence)) 0 4096)]
        (bit-or authority-reason (bit-or area-reason time-reason))))
    0))

(defn govern-reasons [request [:ref :cofog.civil-defense/GovernRequest]] :i64
  (let [event (:event request)
        evidence (:evidence request)
        shape-reason (if (event-shape-valid? event) 0 1)
        prohibited-reason (if (or (contains-prohibited-text? (:summary event))
                                  (contains-prohibited-text? (:instructions event))) 2 0)
        authority-reason (if (:authority-known evidence) 0 4)
        origin-reason (if (:origin-allowed evidence) 0 8)
        signature-reason (if (:signature-valid evidence) 0 16)
        time-reason (if (and (<= (:issued-at event) (:effective-at event))
                             (< (:effective-at event) (:expires-at event))) 0 32)
        expired-reason (if (> (:expires-at event) (:now evidence)) 0 64)
        future-reason (if (<= (:issued-at event) (+ (:now evidence) 300000)) 0 128)
        conflict-reason (if (= (:existing-state evidence) 2) 256 0)]
    (bit-or shape-reason
            (bit-or prohibited-reason
                    (bit-or authority-reason
                            (bit-or origin-reason
                                    (bit-or signature-reason
                                            (bit-or time-reason
                                                    (bit-or expired-reason
                                                            (bit-or future-reason
                                                                    (bit-or conflict-reason
                                                                            (reference-reasons event evidence))))))))))))

(defn govern [request [:ref :cofog.civil-defense/GovernRequest]] [:ref :cofog.civil-defense/Decision]
  (let [source-event (:event request)
        evidence (:evidence request)
        event (event-document source-event)
        hash (document-sha256 event)
        reasons (govern-reasons request)
        operation (operation-for (:kind source-event))
        proposal (proposal-document source-event operation)]
    (if (> reasons 0)
      (->Decision 3 reasons 0 (:event-id source-event) hash event (document-null))
      (if (= (:existing-state evidence) 1)
        (->Decision 2 0 0 (:event-id source-event) hash event (document-null))
        (->Decision 1 0 operation (:event-id source-event) hash event proposal)))))

(defn approval-payload [request [:ref :cofog.civil-defense/ApprovalRequest]] :document
  (document-map
   :schema-version (document-string "cofog-0220-approval/v1")
   :approval-id (document-string (:approval-id request))
   :approver-id (document-string (:approver-id request))
   :event-id (document-string (:approval-event-id request))
   :event-hash (document-string (:approval-event-hash request))
   :operation (document-i64 (:approval-operation request))
   :approved-at (document-i64 (:approved-at request))
   :expires-at (document-i64 (:approval-expires-at request))))

(defn approval-reasons [request [:ref :cofog.civil-defense/ApprovalRequest]] :i64
  (let [decision-reason (if (= (:decision-outcome request) 1) 0 1)
        shape-reason (if (and (nonempty? (:approval-id request))
                              (nonempty? (:approver-id request))) 0 2)
        approver-reason (if (:approver-known request) 0 4)
        signature-reason (if (:signature-valid request) 0 8)
        window-reason (if (and (<= (:approved-at request) (:now request))
                               (> (:approval-expires-at request) (:now request))
                               (< (:approved-at request) (:approval-expires-at request))) 0 16)
        binding-reason (if (string=? (:event-id request) (:approval-event-id request))
                         (if (string=? (:event-hash request) (:approval-event-hash request))
                           (if (= (:operation request) (:approval-operation request)) 0 32)
                           32)
                         32)
        proposal-reason (if (> (:proposal-expires-at request) (:now request)) 0 64)
        replay-reason (if (:already-used request) 128 0)]
    (bit-or decision-reason
            (bit-or shape-reason
                    (bit-or approver-reason
                            (bit-or signature-reason
                                    (bit-or window-reason
                                            (bit-or binding-reason
                                                    (bit-or proposal-reason replay-reason)))))))))

(defn approve [request [:ref :cofog.civil-defense/ApprovalRequest]] [:ref :cofog.civil-defense/ApprovalDecision]
  (let [payload (approval-payload request)
        hash (document-sha256 payload)
        reasons (approval-reasons request)
        outbox-id (string-concat "outbox:" (:approval-id request))]
    (if (> reasons 0)
      (->ApprovalDecision 3 reasons (:approval-id request) "" payload hash)
      (->ApprovalDecision 4 0 (:approval-id request) outbox-id payload hash))))

(defn checkpoint-command
  [decision [:ref :cofog.civil-defense/Decision]
   approval [:ref :cofog.civil-defense/ApprovalDecision]
   expected-version :i64 sequence :i64 previous-hash :string]
  :document
  (let [ledger-entry
        (document-map
         :sequence (document-i64 sequence)
         :previous-hash (document-string previous-hash)
         :event-id (document-string (:event-id decision))
         :event-hash (document-string (:event-hash decision))
         :event (:event decision))
        entry-hash (document-sha256 ledger-entry)
        outbox
        (document-map
         :outbox-id (document-string (:outbox-id approval))
         :event-id (document-string (:event-id decision))
         :event-hash (document-string (:event-hash decision))
         :operation (document-i64 (:operation decision))
         :approval-id (document-string (:approval-id approval))
         :approval-hash (document-string (:payload-hash approval))
         :status (document-keyword :pending)
         :attempt (document-i64 0))]
    (document-map
     :effect (document-keyword :storage-cas-put)
     :key (document-keyword :cofog-0220-state)
     :expected-version (document-i64 expected-version)
     :require-decision-outcome (document-i64 1)
     :require-approval-outcome (document-i64 4)
     :consume-approval-id (document-string (:approval-id approval))
     :ledger-entry (document-assoc ledger-entry :entry-hash (document-string entry-hash))
     :outbox outbox)))

(defn delivery-attestation [request [:ref :cofog.civil-defense/DeliveryRequest]] :document
  (let [body
        (document-map
         :sequence (document-i64 (:sequence request))
         :previous-hash (document-string (:previous-hash request))
         :outbox-id (document-string (:outbox-id request))
         :approval-id (document-string (:approval-id request))
         :event-id (document-string (:event-id request))
         :event-hash (document-string (:event-hash request))
         :operation (document-i64 (:operation request))
         :channel (document-string (:channel request))
         :external-id (document-string (:external-id request))
         :delivered-at (document-i64 (:delivered-at request)))]
    (document-assoc body :attestation-hash (document-string (document-sha256 body)))))

(defn delivery-checkpoint-command [request [:ref :cofog.civil-defense/DeliveryRequest] expected-version :i64] :document
  (document-map
   :effect (document-keyword :storage-cas-put)
   :key (document-keyword :cofog-0220-state)
   :expected-version (document-i64 expected-version)
   :require-outbox-status (document-keyword :dispatching)
   :outbox-id (document-string (:outbox-id request))
   :next-outbox-status (document-keyword :delivered)
   :delivery-attestation (delivery-attestation request)))

(defn valid-fixture [] [:ref :cofog.civil-defense/GovernRequest]
  (->GovernRequest
   (->CivilEvent
    "evt-001" 1 "ua:public-alert-authority:fixture"
    1000000 1001000 2000000 "UA" "UA-30"
    "https://alerts.example.gov.ua"
    "https://alerts.example.gov.ua/events/evt-001"
    2 2 "Follow competent civil authority instructions." ""
    0 0 0 "Civil warning.")
   (->GovernEvidence 1100000 true true true 0 true true true 0)))

(defn approval-fixture [decision [:ref :cofog.civil-defense/Decision] used :bool]
  [:ref :cofog.civil-defense/ApprovalRequest]
  (->ApprovalRequest
   (:outcome decision) (:event-id decision) (:event-hash decision)
   (:operation decision) 2000000
   "approval-001" "operator:fixture"
   (:event-id decision) (:event-hash decision) (:operation decision)
   1100000 1200000 1100000 true true used))

(defn main [] :i64
  (let [decision (govern (valid-fixture))
        unsafe (govern
                (record-assoc [:ref :cofog.civil-defense/GovernRequest]
                              (valid-fixture) :event
                              (record-assoc [:ref :cofog.civil-defense/CivilEvent]
                                            (:event (valid-fixture))
                                            :summary "Compute an intercept point.")))
        approved (approve (approval-fixture decision false))
        replayed (approve (approval-fixture decision true))
        delivery (->DeliveryRequest
                  "outbox:approval-001" "approval-001" "evt-001"
                  (:event-hash decision) 1 "fixture-channel" "delivery-1"
                  1150000 1 "GENESIS")
        attestation (delivery-attestation delivery)]
    (if (and (= (record-get [:ref :cofog.civil-defense/Decision] decision :outcome) 1)
             (= (record-get [:ref :cofog.civil-defense/Decision] decision :operation) 1)
             (= (record-get [:ref :cofog.civil-defense/Decision] unsafe :outcome) 3)
             (> (bit-and (record-get [:ref :cofog.civil-defense/Decision] unsafe :reasons) 2) 0)
             (= (record-get [:ref :cofog.civil-defense/ApprovalDecision] approved :outcome) 4)
             (= (record-get [:ref :cofog.civil-defense/ApprovalDecision] replayed :outcome) 3)
             (> (bit-and (record-get [:ref :cofog.civil-defense/ApprovalDecision] replayed :reasons) 128) 0)
             (= (string-length
                 (option-value-of [:option :string]
                   (document-string-value
                    (option-value-of [:option :document]
                      (document-get attestation :attestation-hash)
                      (document-string "")))
                   "")) 64))
      42
      0)))
